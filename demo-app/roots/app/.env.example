# Printed by `pnpm db:start` (supabase start). These are LOCAL-ONLY development keys: the anon key
# is a signed JWT that anyone with the repo can read, and it is only ever pointed at 127.0.0.1.
#
# The ports are NOT Supabase's defaults. Another local Supabase project may already hold 54321-54323,
# so this stack is moved up to the 544xx range in supabase/config.toml — see RECORDING.md.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=paste-the-ANON_KEY-that-supabase-start-printed
