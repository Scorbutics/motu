# The lagoon host's environment. Copy to .env.local and fill in the GitHub half.
#
# NOTHING HERE IS A PRODUCTION SECRET. The JWT secret and the two keys below are the well-known local
# development values that infra/docker-compose.yml defaults to — they are committed on purpose, so
# `docker compose up` and `pnpm dev` work with no setup. A deployed host overrides every one of
# them, and MOTU_HOST_JWT_SECRET is the one that matters: the keys are signed with it, so a host that
# keeps the default accepts tokens anyone can mint.

# --- where the pieces are ---------------------------------------------------------------------
# The node lagoon host. Everything the app does not own yet is proxied here (phase 0).
MOTU_HOST_UPSTREAM=http://127.0.0.1:8818
# The auth container. Served to browsers as <this app>/auth/v1 — never reached directly.
MOTU_GOTRUE_UPSTREAM=http://127.0.0.1:9998
# What this host is called from outside. GoTrue's SITE_URL and redirect allow-list are built from it,
# so a mismatch here is what makes an OAuth round-trip land on the wrong origin.
MOTU_HOST_PUBLIC_URL=http://127.0.0.1:8817

# --- the Supabase client ----------------------------------------------------------------------
# The gateway path, not the container. @supabase/ssr appends /auth/v1 itself, so this is the origin.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8817
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJtb3R1LWhvc3QiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTczNTY4OTYwMCwiZXhwIjoyMDUxMDQ5NjAwfQ.xU0_Evyzmiw_1uZV1pZELG9yigJdNCvKKgXYIxZNbPQ
# Server-only. Never NEXT_PUBLIC_: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJtb3R1LWhvc3QiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNzM1Njg5NjAwLCJleHAiOjIwNTEwNDk2MDB9.LIoUuQBIlgkNLsc6EEUZ0xMlNgH89CCWoU7afBUaHCw
MOTU_HOST_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# --- postgres ---------------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54342/motu_host

# --- GitHub ------------------------------------------------------------------------------------
# From a GitHub OAuth App whose callback is <MOTU_HOST_PUBLIC_URL>/auth/v1/callback.
# Until these are set, MOTU_GITHUB_ENABLED stays false and the sign-in button reports that plainly
# rather than bouncing somebody to a provider this host has not configured.
MOTU_GITHUB_ENABLED=false
MOTU_GITHUB_CLIENT_ID=
MOTU_GITHUB_SECRET=

# Where the review console's build is. Defaults to the sibling checkout.
MOTU_REVIEW_DIST=

# Where the lagoon host keeps its store (its own unit sets this). NO DEFAULT: a wrong guess reads an
# access.json that is not there and refuses every ingest token as unrecognised, silently.
MOTU_HOST_DIR=
