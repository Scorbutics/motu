<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.motu</groupId>
    <artifactId>endpoint</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>motu endpoint</name>
    <description>Thin adapter proxy exposing existing CDI service beans to the browser without reimplementing authorization.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Provided by the WildFly container. This module never bundles the EE API. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Bundle the freshly-built frontend bridge.js into the jar (WebJar approach), so the
                 embed is a single self-contained artifact and survives host WAR rebuilds/restarts.

                 THE SOURCE PATH WAS `../apps/bridge/dist`, AND `apps/` HAS NOT EXISTED FOR A LONG
                 TIME. maven-resources-plugin skips a missing directory without failing, so the jar
                 has been shipping with no bridge.js at all — and the "committed copy under
                 src/main/resources" this comment used to claim as a fallback was never committed
                 either, so there was nothing to fall back to. Repointed at the real output.

                 STILL AN OPEN QUESTION, deliberately left rather than decided here: this couples the
                 framework jar's build to the DEMO app's Vite output. The alternatives are to commit a
                 real fallback and drop the plugin, or to make a missing bundle fail the build instead
                 of vanishing quietly. Repointing restores the intended behaviour without choosing. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-bridge-bundle</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/dev/motu/assets</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../demo-app/roots/bridge/dist</directory>
                                    <includes>
                                        <include>bridge.js</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
