<?xml version="1.0" encoding="UTF-8"?>
<!--
  motu's Java half.

  WHY A ROOT `java/` AND NOT `packages/java/`. `packages/` is not a neutral word in this repository —
  it is the pnpm workspace root, and pnpm-workspace.yaml, the root tsconfig's project references,
  scripts/build-packages.mjs and the CLI's no-install symlink list all read `packages/*` as "npm
  packages". A Maven subtree inside it would make the word mean two things and force every one of
  those to learn an exception. Two build systems, two roots, and the root directory count goes down
  rather than up.

  These modules are GENERIC JavaEE tooling — they know nothing about any particular ocean. `apt` reads
  annotations and emits a manifest; `endpoint` dispatches browser calls to CDI beans that already
  exist. Neither depends on the other, which is deliberate: a host can generate the manifest at build
  time without deploying the runtime, and deploy the runtime without running the processor.

  This aggregator exists so `mvn install` here builds both. It is not a parent: neither module
  inherits from it, so each still builds standalone.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.motu</groupId>
    <artifactId>java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>motu (java)</name>
    <description>Aggregator for motu's Java modules: the annotation processor and the CDI endpoint adapter.</description>

    <modules>
        <module>apt</module>
        <module>endpoint</module>
    </modules>
</project>
