{
  "name": "motu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "motu": "node packages/cli/src/cli.mjs",
    "build:bridge": "pnpm --filter @demo-app/bridge build",
    "dev:lagoon": "pnpm --filter @demo-app/lagoon dev",
    "dev:focus": "pnpm --filter @demo-app/lagoon focus",
    "dev:console": "pnpm --filter @demo-app/bridge watch:console",
    "gen:contract": "node packages/codegen/src/cli.mjs ../ocean/web-console/target/classes/motu-manifest.json demo-app/contract/src",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
