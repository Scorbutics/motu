{
  "name": "motu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "motu": "node packages/cli/src/cli.mjs",
    "build:bridge": "pnpm --filter @demo-app/bridge build",
    "dev:lagoon": "pnpm --filter @demo-app/lagoon dev",
    "dev:focus": "pnpm --filter @demo-app/lagoon focus",
    "dev:console": "pnpm --filter @demo-app/bridge watch:console",
    "gen:contract": "node packages/codegen/src/cli.mjs ../ocean/web-console/target/classes/motu-manifest.json demo-app/contract/src",
    "typecheck": "tsc -b --noEmit",
    "build:packages": "node scripts/build-packages.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.15.0"
}
