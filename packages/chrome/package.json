{
  "name": "@motu/chrome",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./tokens": "./src/tokens.mjs",
    "./css": "./src/css.mjs",
    "./html": "./src/html.mjs",
    "./kit": "./src/kit.mjs",
    "./mark": "./src/mark.mjs",
    "./splash": "./src/splash.mjs",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "types": "src/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
