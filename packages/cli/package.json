    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.11.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
