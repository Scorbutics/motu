  "keywords": ["motu", "react", "islands", "ui-architecture", "state-management", "custom-elements", "web-components", "component-architecture"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorbutics/motu.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Scorbutics/motu#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@motujs/chrome": "workspace:*",
    "@motujs/types": "workspace:*"
  },
  "files": [
    "dist"
  ],
