{
  "name": "@motu/coverage",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/next": {
      "types": "./dist/server/next.d.ts",
      "default": "./dist/server/next.js"
    },
    "./server/next/known": {
      "types": "./dist/server/next-known.d.ts",
      "default": "./dist/server/next-known.js"
    }
  },
  "dependencies": {
    "@motu/core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
