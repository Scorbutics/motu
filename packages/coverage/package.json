{
  "name": "@motujs/coverage",
  "version": "0.1.1",
  "description": "Coverage for motu regions: which declared states rendered and which backend operations a run actually reached.",
  "keywords": ["motu", "react", "islands", "ui-architecture", "state-management", "coverage", "ui-testing", "instrumentation"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorbutics/motu.git",
    "directory": "packages/coverage"
  },
  "homepage": "https://github.com/Scorbutics/motu#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/next": {
      "types": "./dist/server/next.d.ts",
      "default": "./dist/server/next.js"
    },
    "./server/next/known": {
      "types": "./dist/server/next-known.d.ts",
      "default": "./dist/server/next-known.js"
    }
  },
  "dependencies": {
    "@motujs/core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
