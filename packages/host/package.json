{
  "name": "@motujs/host",
  "version": "0.1.0",
  "description": "Server for the shared motu lagoon host: stores published region previews and serves a live URL per branch.",
  "keywords": ["motu", "react", "islands", "ui-architecture", "state-management", "preview-server", "hosting", "ui-preview"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorbutics/motu.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/Scorbutics/motu#readme",
  "type": "module",
  "bin": {
    "motu-host": "src/cli.mjs"
  },
