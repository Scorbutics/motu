{
  "name": "@motujs/runtime",
  "version": "0.1.1",
  "description": "Transport for motu regions: HTTP, direct and mock backends behind one declared contract, so a region renders with no server.",
  "keywords": ["motu", "react", "islands", "ui-architecture", "state-management", "mock-server", "transport", "fetch", "postgrest", "testing"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorbutics/motu.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/Scorbutics/motu#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./postgrest-fetch": {
      "types": "./dist/postgrest-fetch.d.ts",
      "default": "./dist/postgrest-fetch.js"
    }
  },
  "dependencies": {
    "@motujs/core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
