{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // ONE REACT, for types as well as at runtime. `@motu/*` compile from the framework's own
      // checkout, so their `import type … from "react"` resolves against ITS node_modules — a
      // different @types/react major here (18 vs 19) puts two Reacts in one program and every
      // `<Island>` becomes "cannot be used as a JSX component". The lagoon already dedupes the
      // runtime copy; nothing was doing the same for types.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "motu"]
}
